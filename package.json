{
  "name": "zoo",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "vite build",
    "types": "wrangler types -c core/wrangler.jsonc",
    "check": "bun run types && tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "verify": "bun run check && bun run lint && bun run test",
    "deploy": "bun run build && wrangler deploy -c core/wrangler.jsonc && wrangler deploy"
  }
}
